# Server: local development defaults. Use separately managed real values in production.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://biteiq:biteiq@127.0.0.1:55432/biteiq
# Operator-supplied: generate a unique 32+ character value before production use.
AUTH_SECRET=
APP_URL=http://127.0.0.1:4000
CLIENT_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Operator-supplied server-only USDA FoodData Central key; never use EXPO_PUBLIC_ for it.
USDA_FDC_API_KEY=

# Expo: include /api. Use the operator's LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api
# Optional local demos only. Leave false when testing real account data.
EXPO_PUBLIC_ENABLE_PREVIEWS=false
